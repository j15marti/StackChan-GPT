+bool AudioService::PushPcmToPlaybackQueue(std::vector<int16_t>&& pcm, int sample_rate, bool wait) {
+    if (pcm.empty()) {
+        return true;
+    }
+
+    // Boost voice PCM amplitude (2.0x with soft knee) so GPT-Live speech is loud and clear on CoreS3
+    for (int16_t& s : pcm) {
+        int32_t v = static_cast<int32_t>(s) * 2;
+        if (v > 28000) {
+            v = 28000 + (v - 28000) / 4;
+        } else if (v < -28000) {
+            v = -28000 + (v + 28000) / 4;
+        }
+        s = static_cast<int16_t>(std::clamp<int32_t>(v, -32768, 32767));
+    }
+
+    auto codec = Board::GetInstance().GetAudioCodec();
+    if (codec != nullptr && sample_rate != codec->output_sample_rate()) {
+        SetDecodeSampleRate(sample_rate, OPUS_FRAME_DURATION_MS);
+        if (output_resampler_ != nullptr) {
+            uint32_t target_size = 0;
+            esp_ae_rate_cvt_get_max_out_sample_num(output_resampler_, pcm.size(), &target_size);
+            std::vector<int16_t> resampled(target_size);
+            uint32_t actual_output = target_size;
+            esp_ae_rate_cvt_process(output_resampler_, (esp_ae_sample_t)pcm.data(), pcm.size(),
+                                    (esp_ae_sample_t)resampled.data(), &actual_output);
+            resampled.resize(actual_output);
+            pcm = std::move(resampled);
+        }
+    }
+
+    AudioTask task;
